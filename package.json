{
  "name": "@collana-solutions/react-pattern-ui",
  "version": "7.0.0",
  "description": "Some basic functions and components which are needed in most of projects.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collana-solutions/react-pattern-ui"
  },
  "license": "MIT",
  "author": "collana solutions AG",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.modern.js",
      "require": "./dist/index.js",
      "styles": "./dist/styles.css"
    },
    "./styles": "./dist/styles.css",
    "./styles.css": "./dist/styles.css"
  },
  "main": "dist/index.js",
  "umd:main": "dist/index.umd.js",
  "jsdelivr": "dist/index.umd.js",
  "unpkg": "dist/index.umd.js",
  "module": "dist/index.modern.js",
  "source": "src/index.ts",
  "jsnext:main": "dist/index.modern.js",
  "types": "dist/index.d.ts",
  "styles": "./dist/styles.css",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean-dist && pnpm run build-lib && pnpm run copy-sass",
    "build-lib": "rollup -c",
    "clean-dist": "shx rm -rf dist",
    "copy-sass": "shx cp -r styles dist/scss",
    "lint": "eslint --cache",
    "prepack": "pnpm run build",
    "prepare-pr": "pnpm exec prettier . --write && pnpm run lint && pnpm run build",
    "prettier-check": "prettier --check .",
    "start": "rollup -c -w",
    "start-all": "concurrently \"pnpm run start\" \"pnpm run start-yalc\"",
    "start-yalc": "nodemon --watch dist -x \"yalc push\"",
    "tsc": "tsc",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@collana-solutions/eslint-config": "^3.1.1",
    "@collana-solutions/reactstrap": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "@popperjs/core": "^2.11.8",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "bootstrap": "^5.3.8",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-prettier": "^5.5.7",
    "nodemon": "^3.1.11",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^4.57.1",
    "rollup-plugin-import-css": "^4.2.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-sass": "^1.15.3",
    "rollup-plugin-typescript2": "^0.37.0",
    "sass": "^1.97.3",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "yalc": "^1.0.0-pre.53"
  },
  "peerDependencies": {
    "@fortawesome/fontawesome-svg-core": "^6 || ^7",
    "@fortawesome/free-solid-svg-icons": "^6 || ^7",
    "@fortawesome/react-fontawesome": "^0.1.18 || ^0.2.0 || ^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@collana-solutions/reactstrap": "^10.0.1"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.22.0"
}
